<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Password Reset by Admin</title>
    <style>
      body {
        font-family: Arial, sans-serif;
        background: #f6f8fa;
        margin: 0;
        padding: 20px;
        color: #333;
      }
      .email-container {
        max-width: 600px;
        margin: auto;
        background: white;
        padding: 20px;
        border-radius: 10px;
        border: 1px solid #ddd;
      }
      .header {
        text-align: center;
        padding-bottom: 15px;
        border-bottom: 1px solid #eee;
      }
      .title {
        font-size: 20px;
        font-weight: bold;
        color: #004aad;
      }
      .info-box {
        background: #f1f5ff;
        padding: 15px;
        border-radius: 8px;
        margin: 20px 0;
        font-size: 14px;
      }
      .password-box {
        background: #0d9488;
        color: white;
        padding: 15px;
        border-radius: 8px;
        text-align: center;
        font-size: 24px;
        font-weight: bold;
        letter-spacing: 4px;
        margin: 20px 0;
      }
      .warning {
        color: #d33;
        font-size: 13px;
        margin-top: 10px;
      }
      .footer {
        font-size: 12px;
        margin-top: 25px;
        text-align: center;
        color: #777;
        border-top: 1px solid #eee;
        padding-top: 15px;
      }
    </style>
  </head>
  <body>
    <div class="email-container">
      <div class="header">
        <h2 class="title">ARMC Portal</h2>
      </div>
      <div class="content">
        <h3>Password Reset Notification</h3>
        <p>Dear <strong><%= fullName %></strong>,</p>
        <p>Your password has been reset by Admin IT.</p>
        <div class="info-box">
          <p><strong>Username:</strong> <%= username %></p>
        </div>
        <p>Your new password:</p>
        <div class="password-box"><%= newPassword %></div>
        <p class="warning">
          ⚠️ Please login immediately and change your password for security
          reasons.
        </p>
      </div>
      <div class="footer">
        Regards,<br />
        <strong>ARMC Portal</strong><br />
        (Auto Notification System)<br /><br />
        <em>This email was auto-generated. Please do not reply.</em>
      </div>
    </div>
  </body>
</html>
