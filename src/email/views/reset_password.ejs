<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset Password</title>
    <style>
      body {
        font-family: Arial, sans-serif;
        background: #f6f8fa;
        margin: 0;
        padding: 20px;
        color: #333;
      }
      .email-container {
        max-width: 600px;
        margin: auto;
        background: white;
        padding: 20px;
        border-radius: 10px;
        border: 1px solid #ddd;
      }
      .header {
        text-align: center;
        padding-bottom: 15px;
        border-bottom: 1px solid #eee;
      }
      .title {
        font-size: 20px;
        font-weight: bold;
        color: #0d9488;
      }
      .button {
        display: block;
        width: fit-content;
        background: #0d9488;
        color: white !important;
        padding: 12px 20px;
        text-decoration: none;
        margin: 20px auto;
        border-radius: 8px;
        font-weight: bold;
      }
      .footer {
        font-size: 12px;
        margin-top: 25px;
        text-align: center;
        color: #777;
        border-top: 1px solid #eee;
        padding-top: 15px;
      }
    </style>
  </head>
  <body>
    <div class="email-container">
      <div class="header">
        <h2 class="title">ARMC Portal</h2>
      </div>
      <div class="content">
        <h3>Reset Password</h3>
        <p>Dear <strong><%= fullName %></strong>,</p>
        <p>
          We received a request to reset your password for your ARMC Portal
          account.
        </p>
        <p>Click the button below to reset your password:</p>
        <a class="button" href="<%= resetLink %>">Reset Password</a>
        <p>This link will expire in <strong>1 hour</strong>.</p>
        <p>
          If you did not request a password reset, please ignore this email.
        </p>
      </div>
      <div class="footer">
        Regards,<br />
        <strong>ARMC Portal</strong><br />
        (Auto Notification System)<br /><br />
        <em>This email was auto-generated. Please do not reply.</em>
      </div>
    </div>
  </body>
</html>
