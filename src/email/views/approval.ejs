<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Request Account Approval Notification</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: #f6f8fa;
      margin: 0;
      padding: 20px;
      color: #333;
    }

    .email-container {
      max-width: 600px;
      margin: auto;
      background: white;
      padding: 20px;
      border-radius: 10px;
      border: 1px solid #ddd;
    }

    .header {
      text-align: center;
      padding-bottom: 15px;
      border-bottom: 1px solid #eee;
    }

    .logo {
      width: 150px;

      margin-bottom: 10px;
    }

    .title {
      font-size: 20px;
      font-weight: bold;
      margin-bottom: 15px;
      color: #004aad;
    }

    .content p {
      line-height: 1.5;
      font-size: 14px;
    }

    .info-box {
      background: #f1f5ff;
      padding: 15px;
      border-radius: 8px;
      margin-top: 10px;
      font-size: 14px;
    }

    .button {
      display: block;
      width: fit-content;
      background: #007bff;
      color: white;
      padding: 12px 20px;
      text-decoration: none;
      margin: 20px auto;
      border-radius: 8px;
      font-weight: bold;
    }

    .footer {
      font-size: 12px;
      margin-top: 25px;
      text-align: center;
      color: #777;
      border-top: 1px solid #eee;
      padding-top: 15px;
    }
  </style>
</head>

<body>
  <div style="font-family: Arial, sans-serif; background-color: #f6f8fa; padding: 20px; color: #333;">
    <div
      style="max-width: 600px; margin: auto; background: white; padding: 20px; border-radius: 10px; border: 1px solid #ddd;">

      <div style="text-align: center; padding-bottom: 15px; border-bottom: 1px solid #eee;">
        <h2 style="font-size: 20px; font-weight: bold; color: #0d9488; margin: 0;">ARMC Portal</h2>
      </div>

      <div style="padding: 20px 0;">
        <h3 style="margin-top: 0; color: #333;">New Request Account Notification</h3>

        <p style="font-size: 14px;">Dear <strong><%= approverName %></strong>,</p>
        <p style="font-size: 14px;">You have a new pending request requiring your approval. Below are the details:</p>

        <div
          style="background-color: #f1f5ff; padding: 15px; border-radius: 8px; margin: 20px 0; font-size: 14px; line-height: 1.6;">
          <p style="margin: 5px 0;"><strong>Category Account:</strong> <%= categoryAccount %></p>
          <p style="margin: 5px 0;"><strong>Request Number:</strong> <%= requestNumber %></p>
          <p style="margin: 5px 0;"><strong>Request Date:</strong> <%= requestDate %></p>
          <p style="margin: 5px 0;"><strong>Requestor:</strong> <%= requestorName %></p>
          <hr style="border: 0; border-top: 1px solid #dce4f5; margin: 10px 0;">
          <p style="margin: 5px 0;"><strong>Badge No:</strong> <%= targetBadgeNo %></p>
          <p style="margin: 5px 0;"><strong>Full Name:</strong> <%= targetFullName %></p>
          <p style="margin: 5px 0;"><strong>Email:</strong> <%= targetEmail %></p>
          <p style="margin: 5px 0;"><strong>Purpose:</strong> <%= requestDescription %></p>
        </div>

        <div style="text-align: center; margin: 30px 0;">
          <a href="<%= approvalLink %>"
            style="background-color: #0d9488; color: #ffffff !important; padding: 12px 25px; text-decoration: none; border-radius: 8px; font-weight: bold; display: inline-block;">
            Review & Approve Request
          </a>
        </div>
      </div>

      <div
        style="font-size: 12px; margin-top: 25px; text-align: center; color: #777; border-top: 1px solid #eee; padding-top: 15px;">
        Regards,<br />
        <strong>ARMC Portal</strong><br />
        (Auto Notification System)<br /><br />
        <em>This email was auto-generated by the system. Please do not reply.</em>
      </div>
    </div>
  </div>
</body>

</html>