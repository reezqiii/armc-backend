<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <title>PCMS Access Login Request Form</title>
    <style>
      body {
        font-family: Arial, Helvetica, sans-serif;
        font-size: 10px;
        color: #000;
        margin: 0;
        padding: 0;
      }

      /* Content Wrapper */
      .content-wrapper {
        width: 100%;
      }

      /* Header Section */
      .header-container {
        width: 100%;
        border: 2px solid #000;
        border-collapse: collapse;
        table-layout: fixed;
      }

      .header-container td {
        border: 1px solid #000;
        padding: 5px;
      }
      .logo-cell {
        width: 35%;
        text-align: center;
      }
      .logo-img {
        height: 50px;
      }

      /* Title */
      .title-box {
        text-align: center;
        font-weight: bold;
        font-size: 14px;
        border: 2px solid #000;
        border-top: none;
        padding: 8px;
        background-color: #f2f2f2;
      }

      /* Info Section */
      .info-table {
        width: 100%;
        margin-top: 10px;
        border-collapse: collapse;
      }

      .info-label {
        font-weight: bold;
      }

      .info-table td {
        padding: 2px 0;
      }

      /* Section Bar */
      .section-title {
        background-color: #000;
        color: #fff;
        font-weight: bold;
        padding: 4px 8px;
        margin-top: 15px;
        text-transform: uppercase;
        page-break-after: avoid;
      }

      /* Data Display */
      .data-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 5px;
      }

      .data-table td {
        padding: 5px;
        border: 1px solid #000;
        vertical-align: top;
      }

      .label-col {
        width: 25%;
        font-weight: bold;
        background-color: #fafafa;
      }

      /* CHECKBOX */
      input[type="checkbox"].custom-chk {
        appearance: none;
        -webkit-appearance: none;
        width: 12px;
        height: 12px;
        border: 1px solid #000; 
        background-color: #fff;
        display: inline-block;
        position: relative;
        vertical-align: middle;
        margin-right: 5px;
        cursor: default;
      }

      input[type="checkbox"].custom-chk:checked::after {
        content: "\2713"; 
        font-size: 10px;
        color: #000; 
        position: absolute;
        top: -2px;
        left: 1px;
        font-weight: bold;
      }

      .checkbox-container {
      width: 100%;
      font-size: 0; 
      }

      .checkbox-item {
      display: inline-block;
      width: 33.33%; 
      vertical-align: top;
      font-size: 10px; 
      margin-bottom: 5px;
      box-sizing: border-box;
      }

      .checkbox-item span {
        display: inline-block;
        vertical-align: middle;
        width: 80%; 
        white-space: normal; 
        word-wrap: break-word;
      }

      /* Remarks */
      .remarks-box {
        width: 100%;
        border: 1px solid #000;
        min-height: 60px;
        padding: 8px;
        margin-top: 5px;
      }

      /* Judul Section (Bar Hitam) */
      .section-title {
        background-color: #000;
        color: #fff;
        font-weight: bold;
        padding: 4px 8px;
        margin-top: 15px;
        text-transform: uppercase;
      }

      /* Tabel Tanda Tangan */
      .signature-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 5px; 
      }

      .signature-table th {
        background-color: #f2f2f2; 
        border: 1px solid #000;
        padding: 5px;
        font-size: 9px;
        text-align: center;
      }

      .signature-table td {
        /* width: 25%; */
        border: 1px solid #000;
        text-align: center;
        vertical-align: bottom;
        padding: 10px 5px;
      }

      .sig-space {
        height: 70px; 
      }

      .sig-name {
        margin: 5px 5px 0 5px;
        padding-top: 3px;
        font-size: 10px;
        font-weight: bold;
      }

      .sig-img {
        max-height: 50px; 
        display: block;
        margin: 0 auto 2px auto;
      }

      .sig-date {
        font-size: 10px;
        margin-top: 2px;
        color: #333;
      }

      .sig-space {
        height: 80px;
        vertical-align: bottom !important;
        position: relative;
      }

      .sig-label-row td {
        text-align: center;
        font-size: 9px;
        font-weight: bold;
        padding: 6px 4px;
        border: 1px solid #000;
        background-color: #fafafa;
      }

      .sig-name {
        margin-top: 5px;
        font-size: 9px;
        font-weight: bold;
      }

      .signature-table {
        page-break-inside: avoid;
      }

      .page-break {
        page-break-before: always;
      }
    </style>
  </head>
  <body>
    <table class="header-container">
      <tr>
        <td rowspan="2" class="logo-cell">
          <img
            class="logo-img"
            src="https://www.smoebatam.com/smoe_portal/assets/seatrium/logo/logo_white.png"
            alt="Logo"
          />
        </td>
        <td
          colspan="3"
          style="text-align: center; font-weight: bold; font-size: 13px"
        >
          Information Technology
        </td>
      </tr>
      <tr>
        <td style="width: 25%; font-size: 8px">
          Originated By:<br />IT Application Developer
        </td>
        <td style="width: 25%; font-size: 8px">Revision Date:<br />-</td>
        <td style="width: 15%; font-size: 8px">Revision:<br />5.3</td>
      </tr>
    </table>

    <div class="title-box">
      PCMS ACCESS LOGIN REQUEST FORM<br />
      <span style="font-size: 10px; font-weight: normal"
        >(No Request: <%= requestId %>)</span
      >
    </div>

    <table class="info-table">
      <tr>
        <td class="info-label" style="width: 15%">Requested Date</td>
        <td>:</td>
        <td><%= requestedDate %></td>
      </tr>

      <tr>
        <td class="info-label">Requested By</td>
        <td>:</td>
        <td><%= requestedBy %></td>
      </tr>
    </table>

    <div class="section-title">Employee Description</div>
    <table class="data-table">
      <tr>
        <td class="label-col">Category Account</td>
        <td><%= categoryAccount %></td>
      </tr>
      <tr>
        <td class="label-col">Badge ID</td>
        <td><%= badge %></td>
      </tr>
      <tr>
        <td class="label-col">Full Name</td>
        <td><%= fullName %></td>
      </tr>
      <tr>
        <td class="label-col">Dept</td>
        <td><%= dept %></td>
      </tr>
      <tr>
        <td class="label-col">Position</td>
        <td><%= position %></td>
      </tr>
      <tr>
        <td class="label-col">Project</td>
        <td><%= project %></td>
      </tr>
      <tr>
        <td class="label-col">Email Address</td>
        <td><%= email %></td>
      </tr>
    </table>

    <!-- <div class="section-title">Access Permission</div>
    <table class="data-table">
      <tr>
        <td class="label-col">Company Yard Access</td>
        <td>
          <div class="checkbox-container">
            <% if (Array.isArray(yardAccess) && yardAccess.length) { %> 
              <% yardAccess.forEach(item => { %>
                <div class="checkbox-item">
                  <input type="checkbox" class="custom-chk" checked disabled />
                  <span><%= item.company_name %></span>
                </div>
              <% }) %> 
            <% } else { %> - <% } %>
          </div>
        </td>
      </tr> -->

     <tr>
        <td class="label-col">Application Access</td>
        <td>
          <div class="checkbox-container">
            <% if (Array.isArray(appAccess) && appAccess.length) { %> 
              <% appAccess.forEach(item => { %>
                <div class="checkbox-item">
                  <input type="checkbox" class="custom-chk" checked disabled />
                  <span><%= item.application_name %></span>
                </div>
              <% }) %> 
            <% } else { %> - <% } %>
          </div>
        </td>
      </tr>
    </table>

    <div class="section-title">Remarks</div>
    <table class="data-table">
      <tr>
        <td class="label-col">Purpose</td>
        <td><%= purpose || '-' %></td>
      </tr>
      <tr>
        <td class="label-col">Additional Remarks</td>
        <td><%= remarks || '-' %></td>
      </tr>
    </table>

    <div class="section-title">Approval & Signatures</div>

    <table class="signature-table">
      <thead>
        <tr>
          <th>REQUESTOR DEPARTMENT</th>
          <% if (!isPublicRequest) { %>
            <th>REQUESTOR HOD</th>
            <% } %>
          <th>LEAD IT DEPARTMENT</th>
          <th>IT MGR / ASST.IT MGR</th>
        </tr>
      </thead>

      <tbody>
        <!-- BARIS LABEL -->
        <tr class="sig-label-row">
          <td>Requested By</td>
          <% if (!isPublicRequest) { %>
            <td>Acknowledged By</td>
            <% } %>
          <td>Checked By</td>
          <td>Approved By</td>
        </tr>

        <tr>
          <!-- REQUESTOR -->
          <td class="sig-space">
            <img
              src="data:image/png;base64,<%= logoBase64 %>"
              class="sig-img"
            />
            <div class="sig-name"><%= requestedBy %></div>
            <div class="sig-date"><%= requestedDate %></div>
          </td>

          <!-- HOD -->
           <% if (!isPublicRequest) { %>
          <td class="sig-space">
            <% if (deptHeadName && deptHeadName !== '-') { %>
            <img
              src="data:image/png;base64,<%= logoBase64 %>"
              class="sig-img"
            />
            <% } %>
            <div class="sig-name"><%= deptHeadName || '-' %></div>
            <% if (deptHeadDate) { %>
            <div class="sig-date"><%= deptHeadDate %></div>
            <% } %>
          </td>
          <% } %>

          <!-- LEAD IT -->
          <td class="sig-space">
            <% if (leadItName && leadItName !== '-') { %>
            <img
              src="data:image/png;base64,<%= logoBase64 %>"
              class="sig-img"
            />
            <% } %>
            <div class="sig-name"><%= leadItName || '-' %></div>
            <% if (leadItDate) { %>
            <div class="sig-date"><%= leadItDate %></div>
            <% } %>
          </td>

          <!-- IT MANAGER -->
          <td class="sig-space">
            <% if (itManagerName && itManagerName !== '-') { %>
            <img
              src="data:image/png;base64,<%= logoBase64 %>"
              class="sig-img"
            />
            <% } %>
            <div class="sig-name"><%= itManagerName || '-' %></div>
            <% if (itManagerDate) { %>
            <div class="sig-date"><%= itManagerDate %></div>
            <% } %>
          </td>
        </tr>
      </tbody>
    </table>
  </body>
</html>
